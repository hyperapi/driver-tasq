{
	"name": "@hyperapi/driver-tasq",
	"version": "0.2.0-beta.1",
	"description": "Driver for HyperAPI based on Tasq.",
	"publishConfig": {
		"access": "public"
	},
	"type": "module",
	"main": "src/main.js",
	"types": "types/main.d.ts",
	"exports": {
		".": {
			"import": "./src/main.js",
			"require": "./dist/main.cjs"
		}
	},
	"engines": {
		"node": ">=10.0.0"
	},
	"peerDependencies": {
		"@hyperapi/core": "^0.2.0-beta.2",
		"@kirick/tasq": "^0.2.0-beta.1"
	},
	"devDependencies": {
		"@babel/eslint-parser": "7.21.8",
		"eslint": "8.41.0",
		"eslint-config-xo": "0.43.1",
		"eslint-plugin-import": "2.27.5",
		"eslint-plugin-jsdoc": "46.5.0",
		"eslint-plugin-node": "11.1.0",
		"eslint-plugin-promise": "6.1.1",
		"eslint-plugin-unicorn": "47.0.0",
		"redis": "^4.6.12",
		"valibot": "^0.35",
		"vitest": "^1.6"
	},
	"scripts": {
		"test": "bun run redis:up && npm run test:vitest && bun test --coverage && bun run redis:down",
		"test:vitest": "vitest run --no-file-parallelism",
		"build": "bun run build:types && bun run build:cjs",
		"build:cjs": "bunx esbuild --bundle --platform=node --format=cjs --packages=external --outfile=dist/main.cjs src/main.js",
		"build:types": "bunx tsc --skipLibCheck --declaration --emitDeclarationOnly --outDir types",
		"publish:npm": "pnpm i && bun run build && eslint . && bunx tsc --skipLibCheck --noemit && bun run test && npm publish",
		"publish:npm:beta": "bun run publish:npm --tag beta",
		"redis:up": "docker ps | grep test-hyperapi-driver-tasq >/dev/null || docker run --rm -d -p 41934:6379 --name test-hyperapi-driver-tasq redis:7-alpine",
		"redis:down": "docker stop test-hyperapi-driver-tasq"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/hyperapi/driver-tasq.git"
	},
	"keywords": [
		"hyperapi",
		"driver",
		"tasq"
	],
	"author": "Daniil Kirichenko (https://twitter.com/kirickme)",
	"license": "MIT",
	"bugs": {
		"url": "https://github.com/hyperapi/driver-tasq/issues"
	},
	"homepage": "https://github.com/hyperapi/driver-tasq#readme"
}
