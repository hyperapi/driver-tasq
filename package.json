{
	"name": "@hyperapi/driver-tasq",
	"version": "0.7.0-dev",
	"description": "Driver for HyperAPI based on Tasq.",
	"publishConfig": {
		"access": "public"
	},
	"type": "module",
	"exports": {
		".": {
			"types": {
				"import": "./dist/main.d.mts",
				"require": "./dist/main.d.cts"
			},
			"import": "./dist/main.mjs",
			"require": "./dist/main.cjs"
		}
	},
	"engines": {
		"node": ">=21"
	},
	"peerDependencies": {
		"@hyperapi/core": "github:hyperapi/core#7c1fe4caf68b127a7bfa4f0e41d2e685f9c7cc16",
		"@kirick/tasq": "^0.3.0"
	},
	"devDependencies": {
		"@biomejs/biome": "2.4.10",
		"@kirick/lint": "0.3.3",
		"@types/node": "24.12.3",
		"eslint": "10.2.0",
		"oxlint": "1.58.0",
		"publint": "0.3.21",
		"redis": "^4.7",
		"tsdown": "0.22.3",
		"typescript": "6.0.2",
		"unplugin-unused": "0.5.7",
		"valibot": "1.4.2",
		"vitest": "4.1.9"
	},
	"_devpack": {
		"@hyperapi/core": "../core"
	},
	"scripts": {
		"build": "tsdown src/main.ts --clean --tsconfig tsconfig.main.json --publint --unused --dts --format esm --format cjs",
		"check": "bun run lint && bun run build && bun run test",
		"lint": "biome format && oxlint && eslint . && tsc -b",
		"redis:up": "docker ps | grep test-redis >/dev/null || docker run --rm -d -p 16379:6379 --name test-redis redis:7-alpine",
		"redis:down": "docker stop test-redis",
		"test": "bun run redis:up && npm run test:vitest && bun test --coverage",
		"test:vitest": "rm -r dist/vitest ; tsc -p tsconfig.test.json && vitest run --dir dist/vitest --no-file-parallelism ; rm -r dist/vitest"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/hyperapi/driver-tasq.git"
	},
	"keywords": [
		"hyperapi",
		"driver",
		"tasq"
	],
	"author": "Daniil Kirichenko (https://twitter.com/kirickme)",
	"license": "MIT",
	"bugs": {
		"url": "https://github.com/hyperapi/driver-tasq/issues"
	},
	"homepage": "https://github.com/hyperapi/driver-tasq#readme"
}
