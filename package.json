{
	"name": "@hyperapi/driver-tasq",
	"version": "0.3.0-dev",
	"description": "Driver for HyperAPI based on Tasq.",
	"publishConfig": {
		"access": "public"
	},
	"type": "module",
	"main": "dist/main.js",
	"types": "dist/main.d.ts",
	"exports": {
		".": {
			"types": {
				"import": "./dist/main.d.ts",
				"require": "./dist/main.d.cts"
			},
			"import": "./dist/main.js",
			"require": "./dist/main.cjs"
		}
	},
	"engines": {
		"node": ">=21"
	},
	"peerDependencies": {
		"@hyperapi/core": "github:hyperapi/core#1cd49ca6cd7e875de1a848e9f52be4141f8d55f7",
		"@kirick/tasq": "^0.3.0"
	},
	"devDependencies": {
		"@kirick/eslint-config": "latest",
		"@types/node": "^20",
		"publint": "0.3.12",
		"tsdown": "0.12.2",
		"redis": "^4.7",
		"typescript": "5.8.3",
		"unplugin-unused": "0.5.0",
		"vitest": "3.1.4"
	},
	"scripts": {
		"build": "tsdown src/main.ts --publint --unused --dts --format esm --format cjs",
		"check": "bun run lint && bun run build && bun run test",
		"lint": "eslint . && tsc && (cd test && tsc)",
		"redis:up": "docker ps | grep test-redis >/dev/null || docker run --rm -d -p 16379:6379 --name test-redis redis:7-alpine",
		"redis:down": "docker stop test-redis",
		"test": "bun run redis:up && npm run test:vitest && bun test --coverage",
		"test:vitest": "rm -r dist/vitest ; tsc -p tsconfig.test.json && vitest run --no-file-parallelism ; rm -r dist/vitest"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/hyperapi/driver-tasq.git"
	},
	"keywords": [
		"hyperapi",
		"driver",
		"tasq"
	],
	"author": "Daniil Kirichenko (https://twitter.com/kirickme)",
	"license": "MIT",
	"bugs": {
		"url": "https://github.com/hyperapi/driver-tasq/issues"
	},
	"homepage": "https://github.com/hyperapi/driver-tasq#readme"
}
